# Egger Network Intelligence — variáveis de ambiente (Fase 1)
# Copie para .env e preencha. Nunca commitar o .env real.

# --- apps/api ---
DATABASE_URL=postgres://egger:devpass@localhost:5432/egger?sslmode=disable
MIGRATIONS_DIR=../../infrastructure/database/migrations
HTTP_ADDR=:8080
APP_ENV=development
OTEL_SERVICE_NAME=egger-api
SESSION_TTL_HOURS=168

# --- apps/web ---
# URL do backend usada apenas server-side (Server Components/Route Handlers) —
# nunca exposta ao navegador. Ver apps/web/src/lib/session.ts.
API_BASE_URL=http://localhost:8080/api/v1

# --- infrastructure/docker/docker-compose.dev.yml ---
POSTGRES_USER=egger
POSTGRES_PASSWORD=devpass
POSTGRES_DB=egger
